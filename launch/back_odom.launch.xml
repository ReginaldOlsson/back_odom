<launch>
  <arg name="use_sim_time" default="false"/>
  <arg name="launch_vehicle" default="true" description="Publish the vehicle TF tree. Set false when vehicle.launch.xml is already running."/>
  <arg name="launch_vehicle_interface" default="false"/>
  <arg name="sensor_model" default="boreas_sensor_kit"/>
  <arg name="vehicle_model" default="sample_vehicle"/>
  <arg name="config_file" default="$(find-pkg-share back_odom)/config/config.param.yaml"/>

  <set_parameter name="use_sim_time" value="$(var use_sim_time)"/>

  <!-- base_link -> sensor_kit_base_link -> imu/lidar come from the sensor kit URDF. -->
  <include if="$(var launch_vehicle)" file="$(find-pkg-share tier4_vehicle_launch)/launch/vehicle.launch.xml">
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
    <arg name="launch_vehicle_interface" value="$(var launch_vehicle_interface)"/>
    <arg name="sensor_model" value="$(var sensor_model)"/>
    <arg name="vehicle_model" value="$(var vehicle_model)"/>
  </include>

  <node pkg="back_odom" exec="back_odom_node" name="back_odom_node" output="screen">
    <remap from="/imu/data" to="/boreas/imu"/>
    <remap from="/pointcloud" to="/boreas/pointcloud"/>
    <param from="$(var config_file)"/>
  </node>
</launch>
