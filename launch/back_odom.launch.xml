<launch>
  <!-- Alias: same stack as back_odom_ekf.launch.xml -->
  <arg name="use_sim_time" default="true"/>
  <arg name="launch_vehicle" default="true"/>
  <arg name="launch_vehicle_interface" default="false"/>
  <arg name="sensor_model" default="boreas_sensor_kit"/>
  <arg name="vehicle_model" default="boreas_vehicle"/>
  <arg name="imu_topic" default="/boreas/imu"/>
  <arg name="pointcloud_topic" default="/boreas/pointcloud"/>
  <arg name="config_file" default="$(find-pkg-share back_odom)/config/config.param.yaml"/>
  <arg name="ekf_param_file" default="$(find-pkg-share back_odom)/config/ekf_back_odom.param.yaml"/>

  <include file="$(find-pkg-share back_odom)/launch/back_odom_ekf.launch.xml">
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
    <arg name="launch_vehicle" value="$(var launch_vehicle)"/>
    <arg name="launch_vehicle_interface" value="$(var launch_vehicle_interface)"/>
    <arg name="sensor_model" value="$(var sensor_model)"/>
    <arg name="vehicle_model" value="$(var vehicle_model)"/>
    <arg name="imu_topic" value="$(var imu_topic)"/>
    <arg name="pointcloud_topic" value="$(var pointcloud_topic)"/>
    <arg name="config_file" value="$(var config_file)"/>
    <arg name="ekf_param_file" value="$(var ekf_param_file)"/>
  </include>
</launch>
